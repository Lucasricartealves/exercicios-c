#while - enquanto 
#if - se
# for - Para
#Estrututura de repetição while

valorParaIncrementarA = 1
while valorParaIncrementarA <= 5:
  print (valorParaIncrementarA)
  valorParaIncrementarA += 1
  
  #Trabalhando com paradas 
valorParaIncrementarB = 1
while valorParaIncrementarB < 5:
  print (valorParaIncrementarB)
  if valorParaIncrementarB == 3:
    break 
  valorParaIncrementarB += 1

#Continuando para próximas interação 
valorParaIncrementarC = 0
while valorParaIncrementarC < 5:
  valorParaIncrementarC += 1
  if valorParaIncrementarC == 3:
    continue  
  print(valorParaIncrementarC)

#Loop infinito 
luzEstaAcessa = True
while luzEstaAcessa:
  print("A luz está acessa") 
  luzEstaAcessa = False

