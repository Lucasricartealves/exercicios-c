#funções com parametros 
#f - formatado
#print () - print vazio é quebra de linha 

def somar_dois_valores(valor_a, valor_b):
  soma = valor_a + valor_b
  print(f"primeiro valor indicado: {valor_a}")
  print(f"segundo valor indicado: {valor_b}")
  print(f"soma dos valores: {soma}")
  print()

somar_dois_valores(10, 10)
somar_dois_valores(15, 25)
