#Tabalhando com Arrays (listas)
listaFrutas = ["maça", "banana", "limão"]
print(listaFrutas)

#Conceito de índice - base 0
#acessando um elemento de uma lista 
print(listaFrutas[2])

#acessano o ultimo elemento de uma lista
print(listaFrutas[-2])

#ordenando uma lista, colocando a lista em ordem alfabetica
listaFrutas.sort()
print(listaFrutas)

#loop em uma lista 
#for - para 
#in - em
for umaFruta in listaFrutas:
  print(umaFruta)

#modificando um elemento e uma lista
listaFrutas[0] = "melancia"
print(listaFrutas)

#adicionando elementos em uma lista
listaFrutas.append("Pitaya")
print(listaFrutas)
listaFrutas.append("bucetinha")
print(listaFrutas)

#removendo elementos de uma lista
listaFrutas.remove("Pitaya")
print(listaFrutas)

#medindo o tamanho de uma lista 
print(len(listaFrutas))

#verificando se uma lista esta vazia
#if - se
#else - senao
if len(listaFrutas) == 0:
  print("A lista está vazia")
else:
  print("A lista não está vazia")

#verificando ocorrencias em uma lista
print(listaFrutas.__contains__("mamão"))

